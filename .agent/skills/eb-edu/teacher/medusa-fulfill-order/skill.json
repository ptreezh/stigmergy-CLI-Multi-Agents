{
  "name": "eb-edu-medusa-fulfill-order",
  "version": "1.0",
  "description": "发货管理",
  "author": "电商 AI 实训平台",
  "category": "ecommerce",
  "tags": ["电商", "Medusa", "物流管理"],
  "triggers": {
    "keywords": ["发货", "订单发货", "物流管理"],
    "patterns": ["订单.*发货", "发货.*订单"]
  },
  "parameters": {
    "type": "object",
    "required": ["order_id"],
    "properties": {
      "order_id": {"type": "string", "description": "订单 ID"},
      "items": {"type": "string", "description": "发货商品（格式：item_id:qty,item_id:qty）"},
      "tracking": {"type": "string", "description": "物流单号"},
      "carrier": {"type": "string", "description": "物流公司"}
    }
  },
  "execution": {
    "runtime": "python3",
    "script": "skill.py",
    "timeout": 30
  },
  "permissions": {
    "roles": ["TEACHER", "ADMIN"],
    "requires_auth": true
  },
  "examples": [
    {"input": "订单 order_123 已发货，顺丰 SF123456", "parameters": {"order_id": "order_123", "tracking": "SF123456", "carrier": "顺丰速运"}}
  ]
}
