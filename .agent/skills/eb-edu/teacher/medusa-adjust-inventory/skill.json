{
  "name": "eb-edu-medusa-adjust-inventory",
  "version": "1.0",
  "description": "调整库存",
  "author": "电商 AI 实训平台",
  "category": "ecommerce",
  "tags": ["电商", "Medusa", "库存管理"],
  "triggers": {
    "keywords": ["调整库存", "库存调整", "增加库存", "减少库存"],
    "patterns": ["调整.*库存", "增加.*库存", "减少.*库存"]
  },
  "parameters": {
    "type": "object",
    "required": ["item_id", "quantity"],
    "properties": {
      "item_id": {"type": "string", "description": "库存项 ID"},
      "quantity": {"type": "integer", "description": "调整数量（正数增加，负数减少）"},
      "reason": {"type": "string", "description": "调整原因"}
    }
  },
  "execution": {
    "runtime": "python3",
    "script": "skill.py",
    "timeout": 30
  },
  "permissions": {
    "roles": ["TEACHER", "ADMIN"],
    "requires_auth": true
  },
  "examples": [
    {"input": "增加库存 50 件", "parameters": {"item_id": "inv_123", "quantity": 50, "reason": "新到货"}},
    {"input": "减少库存 5 件", "parameters": {"item_id": "inv_123", "quantity": -5, "reason": "损坏报损"}}
  ]
}
