{
  "name": "eb-edu-medusa-cancel-order",
  "version": "1.0",
  "description": "取消订单",
  "author": "电商 AI 实训平台",
  "category": "ecommerce",
  "tags": ["电商", "Medusa", "订单管理"],
  "triggers": {
    "keywords": ["取消订单", "订单取消"],
    "patterns": ["取消.*订单"]
  },
  "parameters": {
    "type": "object",
    "required": ["order_id"],
    "properties": {
      "order_id": {"type": "string", "description": "订单 ID"},
      "reason": {"type": "string", "description": "取消原因"}
    }
  },
  "execution": {
    "runtime": "python3",
    "script": "skill.py",
    "timeout": 30
  },
  "permissions": {
    "roles": ["TEACHER", "ADMIN"],
    "requires_auth": true
  },
  "examples": [
    {
      "input": "取消订单 order_123",
      "parameters": {"order_id": "order_123"},
      "output": "## ✅ 订单已取消\n\n**订单号**: order_123\n**取消原因**: 客户取消"
    },
    {
      "input": "取消订单 order_123 原因缺货",
      "parameters": {"order_id": "order_123", "reason": "缺货"},
      "output": "## ✅ 订单已取消\n\n**订单号**: order_123\n**取消原因**: 缺货"
    }
  ],
  "errors": {
    "ORDER_NOT_FOUND": {"code": 404, "message": "订单不存在", "solution": "检查订单 ID 是否正确"},
    "ALREADY_CANCELLED": {"code": 400, "message": "订单已取消", "solution": "订单已取消，无法重复取消"}
  }
}
