{
  "name": "eb-edu-medusa-list-customers",
  "version": "1.0",
  "description": "查看客户列表",
  "author": "电商 AI 实训平台",
  "category": "ecommerce",
  "tags": ["电商", "Medusa", "客户管理"],
  "triggers": {
    "keywords": ["查看客户", "客户列表", "客户管理"],
    "patterns": ["查看.*客户", "列出.*客户"]
  },
  "parameters": {
    "type": "object",
    "required": [],
    "properties": {
      "page": {"type": "integer", "default": 1, "description": "页码"},
      "limit": {"type": "integer", "default": 20, "description": "每页数量"},
      "q": {"type": "string", "description": "搜索关键词"}
    }
  },
  "execution": {
    "runtime": "python3",
    "script": "skill.py",
    "timeout": 30
  },
  "permissions": {
    "roles": ["STUDENT", "TEACHER", "ADMIN"],
    "requires_auth": true
  },
  "examples": [
    {"input": "查看客户列表", "parameters": {}},
    {"input": "搜索客户 张三", "parameters": {"q": "张三"}}
  ]
}
