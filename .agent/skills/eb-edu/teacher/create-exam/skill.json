{
  "name": "eb-edu-create-exam",
  "version": "1.0.0",
  "description": "创建考试",
  "author": "电商 AI 实训平台",
  "category": "education",
  "tags": ["电商", "考试", "测试"],
  "triggers": {
    "keywords": ["创建考试", "安排考试", "组织考试"],
    "patterns": ["帮我创建一个.*考试", "安排.*考试"]
  },
  "parameters": {
    "type": "object",
    "required": ["title", "start-time", "end-time"],
    "properties": {
      "title": {"type": "string", "description": "考试标题"},
      "start-time": {"type": "string", "description": "开始时间"},
      "end-time": {"type": "string", "description": "结束时间"},
      "type": {"type": "string", "default": "practical"}
    }
  },
  "execution": {"runtime": "python3", "script": "skill.py", "timeout": 30},
  "permissions": {"roles": ["ADMIN", "SCHOOL_ADMIN", "TEACHER"], "requires_auth": true}
}
