{
  "name": "eb-edu-medusa-refund-order",
  "version": "1.0",
  "description": "订单退款",
  "author": "电商 AI 实训平台",
  "category": "ecommerce",
  "tags": ["电商", "Medusa", "订单管理"],
  "triggers": {
    "keywords": ["订单退款", "退款管理", "处理退款"],
    "patterns": ["退款.*订单", "处理.*退款"]
  },
  "parameters": {
    "type": "object",
    "required": ["order_id", "amount"],
    "properties": {
      "order_id": {"type": "string", "description": "订单 ID"},
      "amount": {"type": "integer", "description": "退款金额"},
      "reason": {"type": "string", "description": "退款原因"}
    }
  },
  "execution": {
    "runtime": "python3",
    "script": "skill.py",
    "timeout": 30
  },
  "permissions": {
    "roles": ["TEACHER", "ADMIN"],
    "requires_auth": true
  },
  "examples": [
    {
      "input": "订单 order_123 退款 199 元",
      "parameters": {"order_id": "order_123", "amount": 199},
      "output": "## ✅ 退款已处理\n\n**订单号**: order_123\n**退款金额**: ¥199"
    },
    {
      "input": "订单 order_123 退款 199 元 原因质量问题",
      "parameters": {"order_id": "order_123", "amount": 199, "reason": "质量问题"},
      "output": "## ✅ 退款已处理\n\n**订单号**: order_123\n**退款金额**: ¥199\n**退款原因**: 质量问题"
    }
  ],
  "errors": {
    "ORDER_NOT_FOUND": {"code": 404, "message": "订单不存在", "solution": "检查订单 ID 是否正确"},
    "INVALID_AMOUNT": {"code": 400, "message": "退款金额无效", "solution": "退款金额不能为负数或超过订单总额"}
  }
}
