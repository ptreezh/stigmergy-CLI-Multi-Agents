{
  "name": "eb-edu-medusa-get-customer",
  "version": "1.0",
  "description": "查看客户详情",
  "author": "电商 AI 实训平台",
  "category": "ecommerce",
  "tags": ["电商", "Medusa", "客户管理"],
  "triggers": {
    "keywords": ["客户详情", "查看客户", "客户信息"],
    "patterns": ["查看.*客户详情", "查询.*客户"]
  },
  "parameters": {
    "type": "object",
    "required": ["customer_id"],
    "properties": {
      "customer_id": {"type": "string", "description": "客户 ID"}
    }
  },
  "execution": {
    "runtime": "python3",
    "script": "skill.py",
    "timeout": 30
  },
  "permissions": {
    "roles": ["TEACHER", "ADMIN"],
    "requires_auth": true
  },
  "examples": [
    {
      "input": "查看客户 cust_123 详情",
      "parameters": {"customer_id": "cust_123"},
      "output": "## 👥 客户详情\n\n**客户 ID**: cust_123\n**姓名**: 张三\n**邮箱**: zhangsan@example.com"
    }
  ],
  "errors": {
    "CUSTOMER_NOT_FOUND": {"code": 404, "message": "客户不存在", "solution": "检查客户 ID 是否正确"}
  }
}
