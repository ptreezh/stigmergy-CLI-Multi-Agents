{
  "name": "eb-edu-create-product-guided",
  "version": "1.0",
  "description": "创建商品（LLM 智能引导版）- 通过 LLM 个性化问答引导学生思考，决策后调用基础 Skill 执行",
  "author": "电商 AI 实训平台",
  "category": "education",
  "tags": ["电商", "实训", "能力培养", "LLM 引导", "商品创建"],
  "triggers": {
    "keywords": ["创建商品实训", "商品上架训练", "学习上架", "商品创建引导"],
    "patterns": ["学习.*创建商品", "我要.*上架训练"]
  },
  "parameters": {
    "type": "object",
    "required": []
  },
  "execution": {
    "runtime": "python3",
    "script": "skill.py",
    "timeout": 900,
    "interactive": true,
    "requires_llm": true
  },
  "permissions": {
    "roles": ["STUDENT"],
    "requires_auth": true
  },
  "learning_outcomes": [
    "商品标题优化能力 - 掌握热搜词、卖点、差异化技巧",
    "定价策略能力 - 能基于成本、竞品、定位制定价格",
    "卖点提炼能力 - 能提炼差异化、痛点导向、可感知的卖点",
    "决策思维能力 - 能说明决策依据",
    "AI 协作能力 - 能与 AI 导师有效互动"
  ],
  "workflow": {
    "type": "llm_guided_then_execute",
    "steps": [
      {"step": 1, "action": "llm_guide", "focus": "商品标题优化"},
      {"step": 2, "action": "llm_guide", "focus": "定价策略"},
      {"step": 3, "action": "llm_guide", "focus": "卖点提炼"},
      {"step": 4, "action": "confirm", "focus": "决策确认"},
      {"step": 5, "action": "call_skill", "skill": "eb-edu-medusa-create-product"}
    ]
  },
  "llm_integration": {
    "description": "本 Skill 依赖 AI LLM 智能引导",
    "supported_llms": ["qwen", "claude", "offline"],
    "prompts": [
      "title_optimization - 评估商品标题",
      "pricing_strategy - 评估定价策略",
      "selling_points - 评估卖点提炼"
    ]
  }
}
