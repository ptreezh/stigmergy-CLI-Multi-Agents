{
  "name": "eb-edu-view-projects",
  "version": "1.0.0",
  "description": "查看实训项目",
  "author": "电商 AI 实训平台",
  "category": "education",
  "tags": ["电商", "实训", "项目列表"],
  "triggers": {
    "keywords": ["查看实训", "我的实训", "实训列表", "作业列表"],
    "patterns": ["看看.*实训", "查询.*作业"]
  },
  "parameters": {
    "type": "object",
    "required": [],
    "properties": {
      "status": {"type": "string", "enum": ["all", "pending", "completed", "graded"], "default": "all"}
    }
  },
  "execution": {"runtime": "python3", "script": "skill.py", "timeout": 30},
  "permissions": {"roles": ["STUDENT", "TEACHER"], "requires_auth": true}
}
