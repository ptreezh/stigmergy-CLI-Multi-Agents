{
  "name": "eb-edu-join-class",
  "version": "1.0.0",
  "description": "加入班级",
  "author": "电商 AI 实训平台",
  "category": "education",
  "tags": ["电商", "学生", "班级"],
  "triggers": {
    "keywords": ["加入班级", "进入班级", "报名班级", "选班"],
    "patterns": ["我要加入.*班", "帮我报名.*班级"]
  },
  "parameters": {
    "type": "object",
    "required": [],
    "properties": {
      "class_name": {"type": "string", "description": "班级名称"},
      "class_id": {"type": "string", "description": "班级 ID"}
    }
  },
  "execution": {"runtime": "python3", "script": "skill.py", "timeout": 30},
  "permissions": {"roles": ["STUDENT"], "requires_auth": true}
}
