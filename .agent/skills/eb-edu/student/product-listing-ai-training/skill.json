{
  "name": "eb-edu-product-listing-ai-training",
  "version": "3.0",
  "description": "商品上架实训（LLM 智能引导版）- 依赖 AI LLM 智能引导，培养学生市场分析、定价策略、卖点提炼能力",
  "author": "电商 AI 实训平台",
  "category": "education",
  "tags": ["电商", "实训", "能力培养", "LLM 引导", "AI 导师"],
  "triggers": {
    "keywords": ["商品上架实训", "AI 实训", "智能训练", "能力训练"],
    "patterns": ["我要.*实训", "帮我.*训练", "学习.*上架"]
  },
  "parameters": {
    "type": "object",
    "required": [],
    "properties": {
      "scenario": {
        "type": "string",
        "enum": ["dress", "headphones"],
        "default": "dress",
        "description": "实训场景"
      },
      "llm": {
        "type": "string",
        "enum": ["qwen", "claude", "offline"],
        "default": "qwen",
        "description": "使用的 LLM"
      }
    }
  },
  "execution": {
    "runtime": "python3",
    "script": "skill.py",
    "timeout": 900,
    "interactive": true,
    "requires_llm": true
  },
  "permissions": {
    "roles": ["STUDENT"],
    "requires_auth": true
  },
  "learning_outcomes": [
    "市场分析能力 - 能分析竞品价格带、销量、卖点",
    "定价策略能力 - 能基于成本、竞品、定位制定价格",
    "卖点提炼能力 - 能提炼差异化卖点",
    "决策思维能力 - 能说明决策依据",
    "AI 协作能力 - 能与 AI 导师有效互动"
  ],
  "llm_integration": {
    "description": "本 Skill 依赖 AI LLM 智能引导",
    "supported_llms": ["qwen", "claude", "offline"],
    "prompts": [
      "market_analysis - 评估学生市场分析",
      "pricing_strategy - 评估学生定价策略",
      "selling_points - 评估学生卖点提炼",
      "final_review - 最终点评"
    ]
  }
}
