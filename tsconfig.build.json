{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist/orchestration",
    "rootDir": "src/orchestration",
    "strict": false,
    "declaration": true,
    "sourceMap": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/orchestration/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}